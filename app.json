{
  "expo": {
    "name": "Bloom",
    "slug": "bloom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kushagra.bloom"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F2FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kushagra.bloom"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#6B3FF0"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Bloom uses the camera to scan the household code on your partner's phone.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bloom lets you add bump photos from your library. They are locked with your household key before they leave the phone.",
          "cameraPermission": "Bloom uses the camera to scan the household code and to take bump photos.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Bloom uses Face ID to keep your health data private when the app lock is on."
        }
      ]
    ],
    "scheme": "bloom",
    "experiments": {
      "typedRoutes": true
    }
  }
}
